-- [[ BIG HEAD LOOP ENGINE ]]
local function ApplyBigHead(v)
    if v ~= LocalPlayer and not Allies[v.UserId] and v.Character and v.Character:FindFirstChild("Head") then
        v.Character.Head.Size = Vector3.new(BigHeadSize, BigHeadSize, BigHeadSize)
        v.Character.Head.CanCollide = true
    end
end

local function TrackPlayerRespawn(p)
    p.CharacterAdded:Connect(function(char)
        if not ScriptRunning then return end
        task.wait(0.2) 
        if BigHeadEnabled then
            ApplyBigHead(p)
        end
    end)
end

for _, p in pairs(Players:GetPlayers()) do TrackPlayerRespawn(p) end
