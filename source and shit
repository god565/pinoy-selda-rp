-- [[ AIM & RAPID FIRE ENGINE (WITH STICKY FOCUS & OBSTRUCTION BYPASS) ]]
RunService.RenderStepped:Connect(function()
    if not ScriptRunning or not IsUnlocked then return end

    if RapidFireEnabled then
        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            local event = tool:FindFirstChild("RemoteEvent") or tool:FindFirstChildOfClass("RemoteEvent") or tool:FindFirstChild("Shoot")
            if event then
                for i = 1, 10 do 
                    task.spawn(function()
                        event:FireServer(Mouse.Hit.Position)
                    end)
                end
            end
        end
    end

    if AimEnabled and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        if LockedTarget then
            local char = LockedTarget.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hum or hum.Health <= 0 or not char:FindFirstChild("Head") then 
                LockedTarget = nil 
            end
        end
        
        if not LockedTarget then
            local t, d = nil, AimFOV
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and not Allies[v.UserId] and v.Character and v.Character:FindFirstChild("Head") and v.Character.Humanoid.Health > 0 and IsVisible(v.Character.Head) then
                    local pos, vis = Camera:WorldToViewportPoint(v.Character.Head.Position)
                    if vis then 
                        local dist = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                        if dist < d then 
                            d = dist
                            t = v 
                        end 
                    end
                end
            end
            LockedTarget = t
        end
        
        if LockedTarget and LockedTarget.Character and LockedTarget.Character:FindFirstChild("Head") then
            local FinalOffset = AimOffset
            if AutoDistanceAdj and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (LocalPlayer.Character.HumanoidRootPart.Position - LockedTarget.Character.Head.Position).Magnitude
                if dist > 25 then FinalOffset = AimOffset + ((dist - 25) * 0.048) end
            end
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, LockedTarget.Character.Head.Position + Vector3.new(0, FinalOffset, 0)), AimSmoothness)
        end
    else 
        LockedTarget = nil 
    end
end)

